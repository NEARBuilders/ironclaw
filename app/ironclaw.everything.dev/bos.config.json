{
  "extends": "bos://work.efiz.near/nearbuilders.org",
  "account": "work.efiz.near",
  "domain": "korea.nearbuilders.org",
  "title": "IronClaw",
  "description": "IronClaw Reborn Dashboard Interface",
  "staging": {
    "domain": "dev.ironclaw..everything.dev"
  },
  "repository": "https://github.com/nearbuilders/ironclaw",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui"
    },
    "api": {
      "development": "local:api",
      "secrets": [
        "API_DATABASE_URL",
        "BETTER_AUTH_SECRET"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "baseUrl": "https://korea.nearbuilders.org",
        "socialProviders": {
          "github": {
            "clientId": "Ov23libvkEQgZ9KF9e9L"
          },
          "google": {
            "clientId": "249571127570-e54ma78sbiniiplhum6eo1c4lipijh3i.apps.googleusercontent.com"
          }
        }
      }
    }
  },
  "plugins": {
    "settings": {
      "extends": "bos://work.efiz.near/nearbuilders.org#plugins.settings",
      "development": "local:plugins/settings"
    },
    "ironclaw": {
      "development": "local:plugins/ironclaw",
      "secrets": []
    }
  }
}
